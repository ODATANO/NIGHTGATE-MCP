{
  "name": "@odatano/nightgate-mcp",
  "version": "0.7.0",
  "description": "MCP server exposing NIGHTGATE (Midnight blockchain attestation layer) to AI agents",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nightgate-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "integration": "npm run build && node --env-file-if-exists=.env scripts/integration-mcp.mjs",
    "live:sponsor-unbound": "npm run build && node --env-file-if-exists=.env scripts/live-sponsor-unbound.mjs",
    "prepublishOnly": "npm run build",
    "live:stdio": "npm run build && node --env-file-if-exists=.env scripts/live-stdio-smoke.mjs",
    "mcp": "node --env-file-if-exists=.env scripts/mcp-cli.mjs",
    "live:field-proof": "npm run build && node --env-file-if-exists=.env scripts/live-field-proof.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODATANO/NIGHTGATE-MCP.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "midnight",
    "blockchain",
    "attestation",
    "zero-knowledge",
    "odata",
    "sap-cap"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@odatano/nightgate-tx": ">=0.6.0"
  },
  "peerDependenciesMeta": {
    "@odatano/nightgate-tx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@odatano/nightgate-tx": "^0.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
