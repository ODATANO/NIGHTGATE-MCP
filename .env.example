# Config for the local test lanes. Copy to .env (gitignored) and fill in.
# `npm run integration` and `npm run live:sponsor-unbound` load it
# automatically; nothing has to be passed on the command line.
#
# The same variables configure the MCP server itself, so this file doubles
# as the reference for an `env` block in a Claude Desktop / Claude Code MCP
# entry.

# --- server it talks to -----------------------------------------------------
# The connection variables are the same for @odatano/core-mcp: one key, both
# chains. The gateway is the default URL; a direct NIGHTGATE instance is
# reached by pointing ODATANO_ACCESS_URL at it (http://localhost:4004).
ODATANO_ACCESS_URL=https://api.odatano.dev
NIGHTGATE_NETWORK=preprod
# The credential is an ODATANO ACCESS key (oda_...): the gateway meters the
# key in units and swaps in the NIGHTGATE agent grant underneath. Get one at
# POST https://api.odatano.dev/keys (x402), from a giveaway code, or by
# signing in at https://api.odatano.dev. Sent as `Authorization: Bearer`.
# A raw AGENT GRANT (ngat_..., sent as x-agent-token) works against a direct
# NIGHTGATE instance: scoped to a named action set, pinned to one session and
# one sponsor, metered per day, revocable. Basic auth is the OPERATOR
# credential and does not belong in an agent process.
ODATANO_ACCESS_KEY=oda_...
# Operator fallback for local admin work only:
# ODATANO_ACCESS_USER=
# ODATANO_ACCESS_PASSWORD=

# --- local building (optional) ----------------------------------------------
# Caller identity for build_sponsorable_transaction. Needs NO funds: the
# sponsor pays the fee. 64 or 128 hex; generate a throwaway with
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
NIGHTGATE_SEED_HEX=

# --- what the live lane targets ---------------------------------------------
NIGHTGATE_VAULT=
# 'attestation-vault' (16 slots, default) or 'attestation-vault-32'. It picks
# the contract class AND the /zk-config the prover keys come from, so it must
# match the lineage the vault address belongs to.
NIGHTGATE_VAULT_ARTIFACT=attestation-vault
# Sponsor session, or the platform pool sentinel (the default).
# NIGHTGATE_SPONSOR_SESSION_ID=00000000-0000-0000-0000-706f6f6c0000

# A first build against a new lineage downloads its prover keys (~114 MB for
# the 32-slot one) before it proves, well past the MCP protocol's own 60 s
# request timeout. 15 minutes by default.
# NIGHTGATE_MCP_CALL_TIMEOUT_MS=900000

# --- optional live round-trip of the offline integration lane ---------------
# NIGHTGATE_LIVE=1
# NIGHTGATE_TEST_CONTRACT=
# NIGHTGATE_TEST_PAYLOAD_HASH=
